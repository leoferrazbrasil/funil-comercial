{
  "name": "funil-comercial",
  "private": true,
  "version": "0.1.0",
  "description": "Protótipo navegável do Funil Comercial para validação do MVP.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/generate-sitemap.mjs",
    "prerender": "node scripts/prerender-core.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "db:apply": "node scripts/apply-supabase-sql.mjs",
    "functions:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-supabase-functions.ps1",
    "routes:smoke": "node scripts/smoke-routes.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "postcss": "^8.5.16",
    "puppeteer": "^25.3.0",
    "tailwindcss": "^3.4.19",
    "ts-morph": "^28.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.110.0",
    "@tanstack/react-query": "^5.101.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.6.0",
    "react-imask": "^7.6.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1"
  }
}
