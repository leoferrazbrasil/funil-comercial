# Configurações do Servidor
SERVER_URL=http://localhost:8080
PORT=8080

# Autenticação da API (Sua Senha Mestra)
AUTHENTICATION_TYPE=apikey
AUTHENTICATION_API_KEY=sua_chave_super_secreta_aqui

# Configurações de Banco de Dados (MySQL)
DATABASE_PROVIDER=mysql
DATABASE_CONNECTION_URI=mysql://usuario:senha@localhost:3306/evolution_db

# Configurações de Instância
INSTANCE_PRESENCE_RETURN=true
INSTANCE_REJECT_CALL=false

# Configurações de Webhook (Para onde a Evolution enviará as mensagens recebidas)
WEBHOOK_GLOBAL_ENABLED=true
WEBHOOK_GLOBAL_URL=https://seu-crm.com/api/whatsapp/webhook
WEBHOOK_GLOBAL_EVENTS=APPLICATION_STARTUP,QRCODE_UPDATED,MESSAGES_UPSERT,MESSAGES_UPDATE,SEND_MESSAGE,CONNECTION_UPDATE
WEBHOOK_EVENTS_ERRORS=false

# Configuração do Redis (Opcional, manter desativado se não tiver Redis na hospedagem)
REDIS_ENABLED=false

# Logs
LOG_LEVEL=ERROR,WARN,DEBUG,INFO
